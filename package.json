{
  "name": "ascrybe",
  "private": true,
  "scripts": {
    "authority:bridge": "node scripts/generate-design-authority-history-bridge.mjs",
    "build": "git ls-files -z -- '*.mjs' | xargs -0 -n1 node --check",
    "dashboard:service:install": "node tools/dashboard-user-service.mjs --install",
    "dashboard:service:render": "node tools/dashboard-user-service.mjs --render",
    "eval:run": "node bin/ascrybe.mjs eval",
    "map:cypher": "node bin/ascrybe.mjs cypher",
    "map:dashboard": "node bin/ascrybe.mjs dashboard",
    "map:project": "node bin/ascrybe.mjs project",
    "map:query": "node bin/ascrybe.mjs query",
    "neo4j:down": "docker compose --env-file .env down",
    "neo4j:up": "docker compose --env-file .env up -d neo4j",
    "package:load": "node bin/ascrybe.mjs package load",
    "package:projection": "node bin/ascrybe.mjs package pack",
    "package:verify": "node bin/ascrybe.mjs package verify",
    "setup": "npm install --ignore-scripts --no-package-lock",
    "skill:bundle": "node bin/ascrybe.mjs skill bundle",
    "skill:verify": "node bin/ascrybe.mjs skill verify",
    "state:init": "node bin/ascrybe.mjs state init",
    "state:migrate": "node bin/ascrybe.mjs state migrate",
    "state:snapshot": "node bin/ascrybe.mjs state snapshot",
    "state:verify": "node bin/ascrybe.mjs state verify",
    "verify": "node scripts/verify-all.mjs",
    "verify:falsifiers": "node scripts/verify-falsifiers.mjs"
  },
  "dependencies": {
    "json5": "2.2.3",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.20.8",
    "yaml": "2.8.3"
  },
  "bin": {
    "ascrybe": "bin/ascrybe.mjs"
  }
}
