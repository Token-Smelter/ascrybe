{
  "schema": "estate-map/runtime-config/v1",
  "models": {
    "documentary_claims": {
      "runner": "pi",
      "name": "<provider/model>",
      "thinking": "off",
      "concurrency": 5,
      "window_bytes": 4000,
      "timeout_ms": 600000,
      "max_event_bytes": 536870912,
      "max_answer_bytes": 4194304
    },
    "code_claims": {
      "runner": "pi",
      "name": "<provider/model>",
      "thinking": "off",
      "concurrency": 5,
      "window_bytes": 4000,
      "timeout_ms": 600000,
      "max_event_bytes": 536870912,
      "max_answer_bytes": 4194304
    },
    "evaluation_arm": {
      "runner": "pi",
      "name": "<provider/model>",
      "thinking": "high",
      "concurrency": 2,
      "window_bytes": 4000,
      "timeout_ms": 900000,
      "max_event_bytes": 536870912,
      "max_answer_bytes": 4194304
    },
    "evaluation_judge": {
      "runner": "pi",
      "name": "<provider/model>",
      "thinking": "high",
      "concurrency": 2,
      "window_bytes": 4000,
      "timeout_ms": 900000,
      "max_event_bytes": 536870912,
      "max_answer_bytes": 4194304
    }
  },
  "neo4j": {
    "uri_env": "ASCRYBE_NEO4J_URI",
    "username_env": "ASCRYBE_NEO4J_USERNAME",
    "password_env": "ASCRYBE_NEO4J_PASSWORD"
  },
  "projection": {
    "batch_size": 500,
    "default_view": "selected",
    "estate": "example-estate"
  },
  "source_repositories": {
    "billing-ledger": "/srv/estates/example-estate/billing-ledger",
    "orders-api": "/srv/estates/example-estate/orders-api",
    "web-storefront": "/srv/estates/example-estate/web-storefront"
  },
  "catalog_globs": [],
  "ontology_classification": {
    "llm_role": "evaluation_judge",
    "llm_max_input_bytes": 100000,
    "system_one": {
      "model": "typesafe/jev-1.13",
      "credential_env": "OPENROUTER_API_KEY"
    }
  },
  "dashboard": {
    "host": "127.0.0.1",
    "port": 8790,
    "neighbor_limit": 120,
    "overview_limit": 100
  }
}
