# Copy to .env on each machine and choose a strong local password. NEVER commit .env.
#
#   cp ascrybe.env.example .env
#   cp ascrybe.config.example.json ascrybe.config.json
#
# .env holds SECRETS and host-specific ports. ascrybe.config.json holds the runtime
# CONTRACT (model roles, bounds, dashboard address) and only NAMES these variables rather
# than containing their values, so the config is safe to read and share while credentials
# stay here.
#
# Model provider authentication is NOT here: Pi owns it. Run `pi --list-models` and confirm
# every model identifier in ascrybe.config.json appears in that output before any paid
# run; the tools hard-abort when a configured role is unavailable.
#
# --- External generated-state custody ---
# Optional. Without this, state:init uses XDG_STATE_HOME/estate-map-runner or
# ~/.local/state/estate-map-runner. This path must be outside the checkout and Git common dir.
# ASCRYBE_ARTIFACT_ROOT=/absolute/path/to/estate-map-runner-state

# --- Neo4j credentials (consumed via the *_env names in ascrybe.config.json) ---
ASCRYBE_NEO4J_USERNAME=neo4j
ASCRYBE_NEO4J_PASSWORD=replace-with-a-long-local-password
ASCRYBE_NEO4J_URI=http://127.0.0.1:7475

# --- Host port mapping for the packaged Neo4j service (compose.yaml) ---
# Defaults avoid 7474/7687 so this never collides with another Neo4j on the machine.
ASCRYBE_NEO4J_HTTP_PORT=7475
ASCRYBE_NEO4J_BOLT_PORT=7688

# --- Optional Neo4j memory sizing; raise for corpus-scale projections ---
# ASCRYBE_NEO4J_HEAP_INITIAL=1G
# ASCRYBE_NEO4J_HEAP_MAX=4G
# ASCRYBE_NEO4J_PAGECACHE=2G
